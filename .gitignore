# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# the Codex sandbox's own temp and cache tree (AGENTS.md); it deletes it, this is the backstop
.sandbox-tmp/

# node
node_modules/
.next/
*.tsbuildinfo

# secrets — never commit an API key
.env
.env.local
tools/.env

# probe output
tools/out/

# the bar store. Market data is never committed: it is regenerable from the feed,
# it is Delta's to publish rather than ours to redistribute, and at a measured
# 143 MB/day (docs/storage.md section 10, not the 50-100 MB/day originally
# estimated) a year of it would be about 52 GB in a git history.
data/

# The local stack's store root. AGENTS.md makes data/ read-only; a second writer into
# data/ would corrupt the live store.
.stack-data/
.stack-logs/
# The local stack's secrets. stack.env is committed with empty values; the real webhook
# URL and anything else secret goes here, and this file is never committed. #66 reads it
# as a second env_file with required:false, so an absent file is simply an unconfigured
# consumer rather than a broken stack.
stack.local.env

# Windows download metadata. `curl`-ing a file into WSL from a browser leaves one of
# these beside every download; they are not part of the repository.
*:Zone.Identifier

# local dev server logs
*.log
*.log.err

# #42: the engine's structured JSON-lines logs, one file per UTC day. Operational
# output, not source — never committed, the same reasoning as data/ above.
logs/
