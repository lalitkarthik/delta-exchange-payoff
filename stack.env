# The feed, store and api all use the Redis bus.
DELTA_BUS=redis
# The Compose service name is the Redis hostname inside the stack.
DELTA_REDIS_URL=redis://redis:6379
# One shared underlying list keeps feed publishers and readers on the same stream keys.
DELTA_LIVE_UNDERLYINGS=BTC
# The stack's writable store mount is /data.
DELTA_STORE_ROOT=/data
# Redis publisher batching interval in milliseconds.
DELTA_BUS_BATCH_MS=50
# Redis retention window in seconds.
DELTA_BUS_RETENTION_SECONDS=1800
# Instance number used in the bus consumer identity.
DELTA_BUS_INSTANCE=1
# The default production stack runs the venue feed.
DELTA_LIVE_FEED=1
# The browser's single-origin proxy address.
PROXY_ORIGIN=http://localhost:8080
# Put the real DISCORD_WEBHOOK_URL in git-ignored stack.local.env; no secret is ever committed here.
DISCORD_WEBHOOK_URL=
